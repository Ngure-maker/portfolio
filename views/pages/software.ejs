<section class="section" style="background: var(--bg-secondary);" id="softwareProjects">
  <div class="container">
    <div class="section-header">
      <span class="section-label reveal">Recent Work</span>
      <h2 class="section-title reveal">Software Projects</h2>
    </div>
    <% if (projects && projects.length > 0) { %>
      <div class="featured-grid">
        <% projects.forEach(function(project) { %>
          <a href="/projects/software/<%= project.slug %>" class="featured-card reveal">
            <div class="featured-card-image">
              <% if (project.heroImage) { %>
                <img src="<%= project.heroImage %>" alt="<%= project.title %>">
              <% } else { %>
                <div class="card-image-placeholder"><i class="fas fa-code"></i></div>
              <% } %>
              <div class="featured-card-overlay">
                <span>View Project <i class="fas fa-arrow-right"></i></span>
              </div>
            </div>
            <div class="featured-card-content">
              <span class="featured-card-category"><%= project.category %></span>
              <h3><%= project.title %></h3>
              <p><%= project.description.substring(0, 120) %>...</p>
            </div>
          </a>
        <% }); %>
      </div>
    <% } else { %>
      <div class="empty-state reveal">
        <i class="fas fa-code"></i>
        <p>Projects coming soon. Check back later.</p>
      </div>
    <% } %>
  </div>
</section>

<section class="section" id="softwareCTA">
  <div class="container" style="text-align: center;">
    <span class="section-label reveal">Let's Build</span>
    <h2 class="section-title reveal" style="max-width: 700px; margin: 0 auto 1.5rem;">Have a Project in Mind?</h2>
    <p style="color: var(--text-muted); margin-bottom: 2rem; max-width: 500px; margin-left: auto; margin-right: auto;" class="reveal">
      From concept to deployment, let's create something exceptional together.
    </p>
    <a href="/contact" class="btn-primary reveal">Start Your Project <i class="fas fa-arrow-right"></i></a>
  </div>
</section>
