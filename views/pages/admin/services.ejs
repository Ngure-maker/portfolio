<%- include('../../partials/admin-header') %>
<div class="admin-main">
  <div class="admin-container">
    <div class="admin-header">
      <h1>Services</h1>
    </div>
    <div class="admin-table">
      <table>
        <thead>
          <tr><th>Title</th><th>Category</th><th>Order</th><th>Published</th></tr>
        </thead>
        <tbody>
          <% if (services && services.length > 0) { %>
            <% services.forEach(function(s) { %>
              <tr>
                <td><%= s.title %></td>
                <td><%= s.category %></td>
                <td><%= s.order %></td>
                <td><%= s.published ? 'Yes' : 'No' %></td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr><td colspan="4" style="text-align: center; color: var(--text-muted);">No services configured.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<%- include('../../partials/admin-footer') %>
